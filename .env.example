# NIQ Prompt Creator — environment variables
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is the committed
# template, so keep every value here empty.
#
# Names are CASE-SENSITIVE and deliberately inconsistent (lowercase for the
# Azure connection, uppercase for the deployment) — they match what
# chat_common/services/llm_service.py and the .prompty frontmatter already read.
# Copy them exactly.


# ---------------------------------------------------------------------------
# Required — Azure OpenAI connection
# Read by chat_common/services/llm_service.py:get_openai_client() and resolved
# in every prompts/*.prompty `${env:...}` block.
# ---------------------------------------------------------------------------

# Azure OpenAI resource endpoint, e.g. https://<resource>.openai.azure.com/
cis_llm_endpoint=

# Azure OpenAI API key. Secret — never commit the filled-in .env.
cis_llm_apikey=

# Azure OpenAI API version, e.g. 2024-10-21.
# Must be >= 2024-08-01-preview for the strict `json_schema` response format in
# prompts/02_clarify.prompty. On an older version, downgrade that block to
# `response_format: {type: json_object}` as the file's own comment describes.
cis_llm_apiversion=

# Value sent as the `X-NIQ-CIS-Consumer` header on every request.
cis_chat_rms_consumer_id=

# Deployment name used as `model.id` in all six .prompty files and as the
# fallback in runtime.py. Despite the "4_DOT_1" name this is just the deployment
# you are pointing at — set it to your GPT-5.x deployment if that is the target.
CIS_LLM_4_DOT_1_DEPLOYMENT=


# ---------------------------------------------------------------------------
# Optional — local chat UI (run_ui.py)
# Defaults shown in comments; leave blank to accept them.
# ---------------------------------------------------------------------------

# Bind address. Default 127.0.0.1 — keep it local unless you mean to expose the
# UI, which has no authentication of any kind.
PROMPT_CREATOR_HOST=

# Port. Default 8000.
PROMPT_CREATOR_PORT=

# Open a browser tab on startup. Default 1; set to 0 to suppress.
PROMPT_CREATOR_OPEN_BROWSER=


# ---------------------------------------------------------------------------
# Optional — read by chat_common but unused by this project's code paths.
# Set them only if you start calling get_embeddings_instance() or
# get_langchain_llm_instance().
# ---------------------------------------------------------------------------

# Environment label, logged as a field on LLM client init.
environment=

# Embedding deployment. Falls back to
# "AskArthur-DocusSearch-text-embedding-ada-002" when unset.
cis_embedding_deployment=

# Value sent as the `X-NIQ-DETECT-HALLUCINATIONS` header by the LangChain client.
DETECT_HALLUCINATIONS=
