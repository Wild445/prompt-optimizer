{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "prompt-creator-ui",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["webapp.app:app", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "prompt-creator-ui-fake-llm",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["webapp.app:app", "--host", "127.0.0.1", "--port", "8010"],
      "env": { "PROMPT_CREATOR_FAKE_LLM": "1" },
      "port": 8010
    }
  ]
}
